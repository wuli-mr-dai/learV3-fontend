# 应用配置
VITE_APP_TITLE=LearV3
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Vue 3 + TypeScript 企业级项目模板

# API 配置
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT=10000

# 功能开关
VITE_ENABLE_MOCK=true
VITE_ENABLE_DEVTOOLS=true

# 认证配置
VITE_AUTH_TOKEN_KEY=learv3_token
VITE_AUTH_USER_KEY=learv3_user

# 路由配置
VITE_ROUTER_MODE=history

# 主题配置
VITE_THEME_PRIMARY=#1890ff
VITE_THEME_SUCCESS=#52c41a
VITE_THEME_WARNING=#faad14
VITE_THEME_ERROR=#f5222d

# 开发服务器配置
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=5173

# 构建配置
VITE_BUILD_SOURCEMAP=true
VITE_BUILD_MINIFY=true

# 第三方服务配置
# VITE_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
# VITE_SENTRY_DSN=YOUR_SENTRY_DSN